# Configure an instance you own or are authorized to use. No default external endpoint.
TRANSLATION_PROVIDER=libretranslate
# Full endpoint, for example http://localhost:5000/translate for a running self-hosted instance.
TRANSLATION_API_URL=
TRANSLATION_API_KEY=
# true if your instance requires a key; false for a self-hosted instance without authentication.
TRANSLATION_REQUIRE_API_KEY=false
TRANSLATION_TIMEOUT_MS=10000

# Stage 9: required at startup; no default account/password. Use a unique
# username (3-64 ASCII letters/digits/._-) and password (12+ chars, <=72 UTF-8 bytes).
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=
# Origin only. Set the actual origin; production requires HTTPS.
ADMIN_ORIGIN=
# Optional origin only (no path/query). HTTPS + reachable host required for phone GPS.
PUBLIC_ORIGIN=

# SQL Server Docker: choose a strong local SA password; never commit .env.
DB_HOST=localhost
DB_PORT=14333
DB_NAME=AutoNarrationDB
DB_USER=sa
DB_PASSWORD=
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true
